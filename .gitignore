# Rust build artifacts — never committed; release builds happen in CI only
/target
**/*.rs.bk

# Model artifacts are fetched by the build script (pinned SHA256), never committed
/models/*
!/models/MANIFEST.toml
!/models/README.md

# Runtime state
/data
*.redb

# Local scratch
*.log
.DS_Store

# Python (train/ offline tooling)
__pycache__/
*.pyc
train/.venv/
deploy/stage/
bench-scratch/
bench-out*/
.env
deploy/compose.override.yaml

# Generated eval index (meridian-eval build) — rebuild from corpus + seed;
# queries.tsv/qrels.txt stay committed (tiny, seed-42 reproducible set)
/eval/data
# Suite-13b dup-heavy artifacts — fully regenerable: gen-dup --seed 42 (tuning)
# / --seed 1337 (hold-out, eval/holdout), then build
/eval/dup-*
/eval/holdout
